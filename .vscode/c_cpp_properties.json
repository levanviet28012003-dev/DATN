{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F103C8T6",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": ["-mcpu=cortex-m3", "-mthumb", "-ffreestanding"],
            "compileCommands": "${workspaceFolder}/firmware/stm32f103c8t6/build/compile_commands.json",
            "intelliSenseMode": "linux-gcc-arm",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/firmware/stm32f103c8t6/core/inc",
                "${workspaceFolder}/firmware/stm32f103c8t6/driver/inc",
                "${workspaceFolder}/firmware/stm32f103c8t6/driver/device/inc",
                "${workspaceFolder}/firmware/stm32f103c8t6/peripheral/inc"
            ],
            "defines": ["STM32F103C8T6", "STM32F103xB"]
        },
        {
            "name": "ROS va STM32",
            "compilerPath": "/usr/bin/gcc",
            "compileCommands": "${workspaceFolder}/firmware/stm32f103c8t6/build/compile_commands.json",
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/firmware/stm32f103c8t6/core/inc",
                "${workspaceFolder}/firmware/stm32f103c8t6/driver/inc",
                "${workspaceFolder}/firmware/stm32f103c8t6/driver/device/inc",
                "${workspaceFolder}/firmware/stm32f103c8t6/peripheral/inc"
            ]
        }
    ]
}
