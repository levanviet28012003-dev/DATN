<?xml version="1.0"?>
<!-- File được sinh bởi scripts/generate_world.py. Không sửa tay; sửa script rồi chạy lại. -->
<sdf version="1.8">
  <world name="outdoor_world">
    <!-- Mốc WGS84 minh họa; cần dùng cùng mốc khi ghép định vị GPS. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>21.0049949</latitude_deg>
      <longitude_deg>105.843951</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Khi world tự khai báo plugin, Gazebo không nạp bộ mặc định nên phải liệt kê đủ. -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.45 0.55 0.35 1</ambient><diffuse>0.45 0.55 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="arena">
      <static>true</static>
      <link name="link">
        <collision name="tree_0_collision"><pose>-30 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_0_visual"><pose>-30 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_1_collision"><pose>-18 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_1_visual"><pose>-18 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_2_collision"><pose>-6 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_2_visual"><pose>-6 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_3_collision"><pose>30 9 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_3_visual"><pose>30 9 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_4_collision"><pose>40 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_4_visual"><pose>40 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_5_collision"><pose>50 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_5_visual"><pose>50 8 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_6_collision"><pose>-17 -12.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_6_visual"><pose>-17 -12.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_7_collision"><pose>3 -14.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_7_visual"><pose>3 -14.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="tree_8_collision"><pose>38 -12.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="tree_8_visual"><pose>38 -12.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.45 0.20 1</ambient><diffuse>0.25 0.45 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="parked_car_collision"><pose>12 -1.4 0.4 0 0 0</pose><geometry><box><size>4.2 1.8 0.8</size></box></geometry></collision>
        <visual name="parked_car_visual"><pose>12 -1.4 0.4 0 0 0</pose><geometry><box><size>4.2 1.8 0.8</size></box></geometry><material><ambient>0.20 0.35 0.70 1</ambient><diffuse>0.20 0.35 0.70 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="cone_0_collision"><pose>30 -2.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="cone_0_visual"><pose>30 -2.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="cone_1_collision"><pose>30 -1.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="cone_1_visual"><pose>30 -1.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="cone_2_collision"><pose>30 -0.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="cone_2_visual"><pose>30 -0.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="cone_3_collision"><pose>30 0.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="cone_3_visual"><pose>30 0.5 0.4 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="motorbike_0_collision"><pose>35 -4 0.4 0 0 0</pose><geometry><box><size>0.7 1.9 0.8</size></box></geometry></collision>
        <visual name="motorbike_0_visual"><pose>35 -4 0.4 0 0 0</pose><geometry><box><size>0.7 1.9 0.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="motorbike_1_collision"><pose>36 -4 0.4 0 0 0</pose><geometry><box><size>0.7 1.9 0.8</size></box></geometry></collision>
        <visual name="motorbike_1_visual"><pose>36 -4 0.4 0 0 0</pose><geometry><box><size>0.7 1.9 0.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="motorbike_2_collision"><pose>37 -4 0.4 0 0 0</pose><geometry><box><size>0.7 1.9 0.8</size></box></geometry></collision>
        <visual name="motorbike_2_visual"><pose>37 -4 0.4 0 0 0</pose><geometry><box><size>0.7 1.9 0.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name="barrier_collision"><pose>46 1.5 0.4 0 0 0</pose><geometry><box><size>0.4 3 0.8</size></box></geometry></collision>
        <visual name="barrier_visual"><pose>46 1.5 0.4 0 0 0</pose><geometry><box><size>0.4 3 0.8</size></box></geometry><material><ambient>0.90 0.90 0.20 1</ambient><diffuse>0.90 0.90 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>
  </world>
</sdf>
