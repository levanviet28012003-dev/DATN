<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_car">
  <!-- Đơn vị mét, kg, radian; +X trước, +Y trái, +Z lên; base_link ở giữa hai trục bánh. -->
  <xacro:property name="base_length" value="0.270"/>
  <xacro:property name="base_width" value="0.1205"/>
  <xacro:property name="plate_thickness" value="0.002"/>
  <!-- Tâm tầng trên cao hơn trục bánh 43 mm. -->
  <xacro:property name="upper_deck_z" value="0.043"/>
  <!-- Thông số kích thước và khối lượng bánh xe. -->
  <xacro:property name="wheel_radius" value="0.0375"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="wheelbase" value="0.165"/>
  <xacro:property name="track_width" value="0.167"/>
  <xacro:property name="wheel_mass" value="0.080"/>
  <xacro:property name="base_mass" value="0.64"/>
  <!-- Lidar 2D: kích thước, khối lượng và tầm đo ước lượng theo loại RPLIDAR A1. -->
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.040"/>
  <xacro:property name="lidar_mass" value="0.170"/>
  <xacro:property name="lidar_range_min" value="0.15"/>
  <xacro:property name="lidar_range_max" value="12.0"/>
  <xacro:property name="palette" value="${dict(chassis='0.20 0.21 0.22 1', black='0.045 0.048 0.052 1', rubber='0.035 0.037 0.040 1', red='0.95 0.035 0.055 1', silver='0.70 0.72 0.74 1', gold='0.78 0.65 0.28 1')}"/>
  <xacro:macro name="paint" params="color">
    <!-- Khai báo màu RGBA trực tiếp để Gazebo giữ đúng màu. -->
    <material name="${color}"><color rgba="${palette[color]}"/></material>
  </xacro:macro>
  <!-- Mẫu tạo hình hộp và hình trụ để hiển thị. -->
  <xacro:macro name="box_visual" params="xyz size material">
    <visual><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry><xacro:paint color="${material}"/></visual>
  </xacro:macro>
  <xacro:macro name="cylinder_visual" params="xyz radius length material rpy:='0 0 0'">
    <visual><origin xyz="${xyz}" rpy="${rpy}"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry><xacro:paint color="${material}"/></visual>
  </xacro:macro>
  <!-- Thân xe gồm hai tầng, cụm cơ khí và thông số vật lý. -->
  <link name="base_link">
    <inertial><origin xyz="-0.015 0 0.015"/><mass value="${base_mass}"/>
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0035" iyz="0" izz="0.0041"/>
    </inertial>
    <visual><origin xyz="0 0 -0.009"/><geometry><mesh filename="package://ackermann_description/meshes/chassis_plate.stl"/></geometry><xacro:paint color="chassis"/></visual>
    <visual><origin xyz="0 0 ${upper_deck_z}"/><geometry><mesh filename="package://ackermann_description/meshes/chassis_plate.stl"/></geometry><xacro:paint color="chassis"/></visual>
    <collision name="lower_deck"><origin xyz="0 0 -0.009"/><geometry><box size="${base_length} ${base_width} ${plate_thickness}"/></geometry></collision>
    <collision name="upper_deck"><origin xyz="0 0 ${upper_deck_z}"/><geometry><box size="${base_length} ${base_width} ${plate_thickness}"/></geometry></collision>
    <!-- Servo LD-1501MG kích thước 40 × 20 × 40,5 mm, lắp ngang xe. -->
    <xacro:box_visual xyz="0.083 0 0.013" size="0.020 0.040 0.0405" material="black"/>
    <xacro:box_visual xyz="0.096 0 0.006" size="0.003 0.049 0.028" material="black"/>
    <xacro:box_visual xyz="0.064 0 -0.001" size="0.010 0.130 0.004" material="silver"/>
    <xacro:box_visual xyz="0.082 0 0.031" size="0.008 0.030 0.003" material="silver"/>
    <collision name="servo"><origin xyz="0.083 0 0.013"/><geometry><box size="0.020 0.040 0.0405"/></geometry></collision>
    <!-- Tạo motor và trụ đỡ: s = 1 bên trái, s = -1 bên phải. -->
    <xacro:macro name="hardware_side" params="s">
      <xacro:cylinder_visual xyz="-0.0825 ${s*0.042} 0.008" radius="0.018" length="0.040" rpy="${pi/2} 0 0" material="silver"/>
      <xacro:box_visual xyz="-0.0825 ${s*0.062} 0.008" size="0.030 0.016 0.033" material="black"/>
      <xacro:macro name="post" params="x y">
        <xacro:cylinder_visual xyz="${x} ${y} 0.017" radius="0.0025" length="0.050" material="gold"/>
        <xacro:cylinder_visual xyz="${x} ${y} 0.045" radius="0.0035" length="0.002" material="silver"/>
      </xacro:macro>
      <xacro:post x="0.110" y="${s*0.044}"/>
      <xacro:post x="0.045" y="${s*0.040}"/>
      <xacro:post x="-0.115" y="${s*0.049}"/>
    </xacro:macro>
    <xacro:hardware_side s="1"/><xacro:hardware_side s="-1"/>
  </link>
  <!-- Frame tại tâm trục sau, không có khối lượng. Nav2 dùng frame này làm gốc của xe vì mô hình
       Ackermann (plugin lái, Smac Hybrid-A*, RPP, MPPI) lấy tâm trục sau làm điểm tham chiếu. -->
  <link name="rear_axle"/>
  <joint name="rear_axle_joint" type="fixed">
    <parent link="base_link"/><child link="rear_axle"/>
    <origin xyz="${-wheelbase/2} 0 0"/>
  </joint>
  <!-- Lidar 2D quét 360°, đặt giữa tầng trên; gốc lidar_link là tâm mặt phẳng quét. -->
  <link name="lidar_link">
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${lidar_mass*(3*lidar_radius**2+lidar_height**2)/12}" ixy="0" ixz="0"
               iyy="${lidar_mass*(3*lidar_radius**2+lidar_height**2)/12}" iyz="0"
               izz="${lidar_mass*lidar_radius**2/2}"/>
    </inertial>
    <xacro:cylinder_visual xyz="0 0 0" radius="${lidar_radius}" length="${lidar_height}" material="black"/>
    <collision name="lidar_body">
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0 0 ${upper_deck_z+plate_thickness/2+lidar_height/2}"/>
  </joint>
  <!-- GPS mô phỏng gắn phía sau Lidar, trên tầng trên. -->
  <link name="gps_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.000000121667" ixy="0" ixz="0"
               iyy="0.000000121667" iyz="0" izz="0.000000213333"/>
    </inertial>
    <xacro:box_visual xyz="0 0 0" size="0.016 0.016 0.006" material="silver"/>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/>
    <origin xyz="-0.070 0 ${upper_deck_z+plate_thickness/2+0.003}"/>
  </joint>
  <!-- NavSat dùng plugin riêng trong world; không cần bộ dựng hình của Lidar. -->
  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <topic>/model/ackermann_car/gps/fix</topic>
      <ignition_frame_id>gps_link</ignition_frame_id>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <!-- Chưa thêm nhiễu để kiểm chứng tọa độ; chưa mô phỏng sai số điện thoại. -->
      <navsat/>
    </sensor>
  </gazebo>
  <!-- Cảm biến chỉ phát dữ liệu khi world có plugin Sensors (xem ackermann_bringup/worlds/nav_world.sdf). -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/model/ackermann_car/scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <!-- 360 tia cách nhau 1°, từ -180° đến 179° để không trùng tia đầu và tia cuối. -->
            <samples>360</samples><resolution>1</resolution>
            <min_angle>${-pi}</min_angle><max_angle>${pi*179/180}</max_angle>
          </horizontal>
        </scan>
        <!-- Tầm đo nhỏ nhất lớn hơn thân xe nên tia không chạm chính xe. -->
        <range><min>${lidar_range_min}</min><max>${lidar_range_max}</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- Bánh xe gồm lốp đen, viền đỏ, nan đen và ốc bạc. -->
  <xacro:macro name="wheel_visual" params="color">
    <visual name="wheel_${color}">
      <geometry><mesh filename="package://ackermann_description/meshes/wheel_${color}.stl"/></geometry>
      <xacro:paint color="${color}"/>
    </visual>
  </xacro:macro>
  <!-- Tạo bánh xe với hình va chạm, khối lượng, quán tính và ma sát. -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}_wheel">
      <xacro:wheel_visual color="rubber"/>
      <xacro:wheel_visual color="red"/>
      <xacro:wheel_visual color="black"/>
      <xacro:wheel_visual color="silver"/>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius**2+wheel_width**2)/12}" ixy="0" ixz="0" iyy="${wheel_mass*wheel_radius**2/2}" iyz="0" izz="${wheel_mass*(3*wheel_radius**2+wheel_width**2)/12}"/>
      </inertial>
    </link>
    <gazebo reference="${name}_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <!-- Tạo bánh trước, bánh sau và các khớp cho mỗi bên xe. -->
  <xacro:macro name="axle_side" params="side s">
    <xacro:wheel name="front_${side}"/><xacro:wheel name="rear_${side}"/>
    <link name="front_${side}_steering_link">
      <xacro:box_visual xyz="0 ${-s*0.012} 0" size="0.022 0.014 0.016" material="black"/>
      <inertial><mass value="0.020"/><inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/></inertial>
    </link>
    <!-- Khớp lái quay quanh trục Z, giới hạn ±0,6 radian. -->
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/><child link="front_${side}_steering_link"/>
      <origin xyz="${wheelbase/2} ${s*track_width/2} 0"/><axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="1.67" velocity="6.5"/><dynamics damping="0.05" friction="0.01"/>
    </joint>
    <!-- Bánh trước quay tự do quanh trục Y. -->
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_steering_link"/><child link="front_${side}_wheel"/>
      <axis xyz="0 1 0"/><dynamics damping="0.0002" friction="0.0001"/>
    </joint>
    <!-- Bánh sau quay quanh trục Y để truyền động. -->
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="rear_${side}_wheel"/>
      <origin xyz="${-wheelbase/2} ${s*track_width/2} 0"/><axis xyz="0 1 0"/>
      <dynamics damping="0.0002" friction="0.0001"/>
    </joint>
  </xacro:macro>
  <xacro:axle_side side="left" s="1"/><xacro:axle_side side="right" s="-1"/>
  <!-- Plugin điều khiển hai bánh sau và tính góc lái riêng cho hai bánh trước. -->
  <gazebo>
    <plugin filename="ignition-gazebo-ackermann-steering-system"
            name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <kingpin_width>${track_width}</kingpin_width>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <!-- Giới hạn bán kính rẽ để góc bánh trong không vượt quá giới hạn khớp 0,6 rad. -->
      <steering_limit>0.45</steering_limit>
      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-1.0</min_acceleration>
      <max_acceleration>1.0</max_acceleration>
      <topic>/model/ackermann_car/cmd_vel</topic>
      <odom_topic>/model/ackermann_car/wheel_odometry</odom_topic>
      <tf_topic>/model/ackermann_car/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- Lấy vị trí thật trong Gazebo làm phản hồi bám đường, tránh trôi odometry từ bánh xe. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/ackermann_car/odometry</odom_topic>
      <tf_topic>/model/ackermann_car/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <!-- Xuất vị trí và vận tốc thực của các khớp từ mô phỏng. -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/model/ackermann_car/joint_state</topic>
      <joint_name>front_left_steering_joint</joint_name>
      <joint_name>front_right_steering_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
